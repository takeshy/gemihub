# gemihub production configuration. Copy to .env.production; never commit secret values.
NODE_ENV=production
DEMO_MODE=false
PORT=8080
APP_ORIGIN=https://gemihub.net
SITE_DOMAIN=shops.gemihub.net
# Keep the existing database and encryption key when updating an existing installation.
GOOGLE_CLOUD_PROJECT=geminihub-486523
FIRESTORE_DATABASE_ID=gemihub
SESSION_SECRET=
# Google OAuth web client: authorized redirect URI is exactly the URL below.
# https://gemihub.net/auth/google/callback
# Shared VM registration injects these from the existing Secret Manager versions:
# projects/495062043717/secrets/google-client-id/versions/1
# projects/495062043717/secrets/google-client-secret/versions/1
# For manual startup outside the shared deployer, supply the resolved values in the environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=
# PayPal remains Sandbox until explicitly configured with Live credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
