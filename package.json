    "parse5": "^8.0.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "ws": "8.22.0",
    "wysimark-lite": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.2",
    "playwright": "^1.63.0",
    "storybook": "^10.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
