{
  "name": "gemihub",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "storybook": "storybook dev -p 6005 --host 0.0.0.0 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "capture:manual": "node scripts/capture-manual.mjs",
    "check:multimodal": "node scripts/check-multimodal.mjs",
    "check:review-chat": "node --import tsx scripts/check-review-chat.mjs",
    "check:shop-reset": "node --import tsx scripts/check-shop-reset.mjs",
    "check:judge-controls": "node --import tsx scripts/check-judge-controls.mjs",
    "check:initial-theme": "node --import tsx scripts/check-initial-theme.mjs",
    "check:onboarding-recovery": "node --import tsx scripts/check-onboarding-recovery.mjs",
    "check:theme-layout": "node --import tsx scripts/check-theme-layout.mjs",
    "check:theme-editors": "node --import tsx scripts/check-theme-editors.mjs",
    "check:fixture-scope": "node --import tsx scripts/check-fixture-scope.mjs",
    "check:mobile-inputs": "node scripts/check-mobile-inputs.mjs",
    "check:assistant-markdown": "node --import tsx scripts/check-assistant-markdown.mjs",
    "check:visual-chat": "node --import tsx scripts/check-visual-chat.mjs",
    "check:chat": "node scripts/check-chat.mjs",
    "check:chat-failures": "node scripts/check-chat-failures.mjs",
    "check:storybook": "node scripts/check-storybook.mjs",
    "check:storybook:transfers": "node scripts/check-storybook-transfers.mjs",
    "check:articles": "node scripts/check-article-authoring.mjs",
    "check:draft-save": "node --import tsx scripts/check-draft-save.mjs",
    "check:paypal-proposals": "node --import tsx scripts/check-paypal-proposals.mjs",
    "check:judge-paypal": "node --import tsx scripts/check-judge-paypal.mjs",
    "check:staff-images": "node scripts/check-staff-images.mjs",
    "check:owner-booking": "node --import tsx scripts/check-owner-booking.mjs",
    "check:settings-recovery": "node --import tsx scripts/check-settings-recovery.mjs",
    "check:email-login": "node --import tsx scripts/check-email-login.mjs",
    "check:booking-complete": "node --import tsx scripts/check-booking-complete.mjs",
