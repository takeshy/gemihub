{
  "name": "gemihub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "storybook": "storybook dev -p 6005 --host 0.0.0.0 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "capture:manual": "node scripts/capture-manual.mjs",
    "check:multimodal": "node scripts/check-multimodal.mjs",
    "check:chat": "node scripts/check-chat.mjs",
    "check:storybook": "node scripts/check-storybook.mjs",
    "check:articles": "node scripts/check-article-authoring.mjs",
    "check:staff-images": "node scripts/check-staff-images.mjs",
    "check:inquiries": "node scripts/check-inquiries.mjs",
    "check:images": "node scripts/check-image-library.mjs",
    "check:drive-artifacts": "node --import tsx scripts/check-drive-artifacts.mjs",
    "check:publication-routing": "node scripts/check-publication-routing.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:browser": "node --import tsx scripts/check-i18n-browser.mjs",
    "capture:manual:en": "node scripts/capture-manual-en.mjs",
    "check:payments": "node scripts/check-payments.mjs",
    "check:drive-payments": "PAYMENT_PREVIEW=true node --import tsx scripts/check-drive-artifacts.mjs",
    "check:paypal:sandbox": "node --env-file-if-exists=.env --import tsx scripts/check-paypal-sandbox.mjs",
    "check:paypal:e2e": "node --env-file-if-exists=.env --import tsx scripts/check-paypal-e2e.mjs",
    "check:paypal:recovery": "node --env-file-if-exists=.env --import tsx scripts/check-paypal-refund-recovery.mjs",
    "start:production": "node --env-file=.env.production --import tsx server/index.ts",
    "check:lp": "node --import tsx scripts/check-landing.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google/genai": "2.13.0",
    "@noble/hashes": "^2.4.0",
    "googleapis": "171.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "wysimark-lite": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.63.0",
    "storybook": "^10.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
