    "check:settings-ai": "node --import tsx scripts/check-settings-ai.mjs",
    "check:dashboard-navigation": "node --import tsx scripts/check-dashboard-navigation.mjs",
    "check:inquiries": "node scripts/check-inquiries.mjs",
    "check:images": "node scripts/check-image-library.mjs",
    "check:image-delivery": "node --import tsx scripts/check-image-delivery.mjs",
    "check:booking-login": "node --import tsx scripts/check-booking-login.mjs",
    "check:drive-artifacts": "node --import tsx scripts/check-drive-artifacts.mjs",
    "check:publication-routing": "node scripts/check-publication-routing.mjs",
    "check:design-versions": "node --import tsx scripts/check-design-versions.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:region": "node --import tsx scripts/check-region.mjs",
