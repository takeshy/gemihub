# ローカルの動作確認だけなら true。本番では必ず false。
DEMO_MODE=true
PORT=3000
APP_ORIGIN=http://localhost:3000
# サービスの状態は Firestore。DEMO_MODE=true のローカル実行だけメモリ内（再起動で消去）。
FIRESTORE_DATABASE_ID=(default)
# ローカルで Firestore Emulator を使う場合のみ。クラウドの実 DB は不要。
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# 本番では十分長いランダム値（32文字以上）。変更すると保存した OAuth token を復号できなくなります。
SESSION_SECRET=
# サーバーの Application Default Credentials を使用。店主に API キーの入力は不要。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 利用するプロジェクト・リージョンで有効な Gemini のモデル ID を設定
VERTEX_MODEL=
# Live 対応モデルと対応リージョンを指定。ブラウザには資格情報を渡さずサーバーから接続。
VERTEX_LIVE_MODEL=
VERTEX_LIVE_LOCATION=us-central1
# ブラウザの書き起こし／タイプ入力を随時整理する Flash-Lite モデル
VERTEX_FLASH_LITE_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ワイルドカード DNS / HTTPS が設定済みの公開側ドメイン（例：shops.example.com）
SITE_DOMAIN=
# 使用するモデル（未指定時は gemini-3.8-flash / gemini-nano-banana-2.1）
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

