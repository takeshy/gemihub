# Use true only for local demos; always false in production.
DEMO_MODE=true
PORT=3000
APP_ORIGIN=http://localhost:3000
# Production: copy .env.production.example to .env.production for https://gemihub.net.
# Business and operational data use Firestore. Local DEMO_MODE=true uses memory and resets on restart.
FIRESTORE_DATABASE_ID=gemihub
# For local Firestore Emulator testing only; a cloud database is not required.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Use a persistent random secret of at least 32 characters in production. Changing it invalidates encrypted OAuth tokens.
SESSION_SECRET=
# Uses server Application Default Credentials; shop owners do not enter API keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set a Gemini model ID available in your project and region.
VERTEX_MODEL=
# Optional independent first-theme reviewer; empty uses VERTEX_MODEL in a fresh context.
VERTEX_REVIEW_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public domain with wildcard DNS/HTTPS configured (e.g. shops.example.com).
SITE_DOMAIN=
# Configured models (defaults: gemini-3.8-flash / gemini-nano-banana-2.1).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Image region: falls back to GOOGLE_CLOUD_LOCATION, then global.
VERTEX_IMAGE_LOCATION=global

# PayPal: Sandboxで検証。秘密情報はサーバーのみで使用します。
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
# Secret Managerから環境変数で渡すか、ローカルのファイルパスを指定（両方ある場合は環境変数を優先）。
PAYPAL_CLIENT_SECRET=
PAYPAL_CLIENT_SECRET_FILE=tmp/paypal.secret
# PayPal Alerts: 定期チェックの間隔（分）と、各ルールのしきい値。
# PAYPAL_ALERT_INTERVAL_MINUTES=60
# PAYPAL_REFUND_STALL_HOURS=2
# PAYPAL_CAPTURE_STALL_MINUTES=15

# Sandbox E2E検証用（サーバーの決済認証には使用しません）
# PAYPAL_BUYER_FILE=tmp/paypal.personal.json

# Hackathon judge access (unset JUDGE_INVITE to disable). Never commit real values.
# JUDGE_INVITE=
# JUDGE_UNTIL=2027-01-31T15:00:00Z
# JUDGE_AI_LIMIT=200
# Invitation password required before a new Google owner creates a shop.
# ACCESS_PASSWORD=
# Google accounts allowed to open /admin (comma-separated).
# ADMIN_EMAILS=
# Optional OpenAI provider, selectable from /admin.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_REVIEW_MODEL=
# OPENAI_IMAGE_MODEL=
# Optional Gemini Live model for the assistant's voice ("Consult & ask"). Empty hides voice.
# VERTEX_LIVE_MODEL=
# VERTEX_LIVE_LOCATION=us-central1
